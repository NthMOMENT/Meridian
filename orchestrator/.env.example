# for rate limit resilience. Format: https://arb-sepolia.g.alchemy.com/v2/YOUR_KEY_HERE
ALCHEMY_RPC_URL_1=
ALCHEMY_RPC_URL_2=

# Robinhood Chain Testnet RPC (public endpoint — no key needed)
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
